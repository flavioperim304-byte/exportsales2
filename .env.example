# Site configuration → Environment variables on Netlify.
# Set the scope to both Builds and Functions, then redeploy.
# Do not prefix these with NEXT_PUBLIC_.

EXA_API_KEY=
FIRECRAWL_API_KEY=
OPENAI_API_KEY=
PARALLEL_API_KEY=
# FastAPI RAG on Render. The desk compares new companies to the Chroma index.
RAG_API_URL=https://exportsales2.onrender.com
# Optional. Supabase Session pooler URI (port 5432). You can also paste it on /sources.
# Direct db.*.supabase.co often fails on Render (IPv6). Do not use the https API URL.
DATABASE_URL=
# HTTPS origin that Exa POSTs to. Defaults to https://exportsales.onrender.com/api/exa/webhook
EXA_WEBHOOK_URL=
