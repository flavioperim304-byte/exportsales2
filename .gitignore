# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local desk state and API keys
/data/runs.json
/data/prompts.json
/data/secrets.json
/data/trade-records.json
/data/*.tmp
/api-keys.env

# fetched docs used while building
/agent-tools

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# packaged download and text dumps
/public/export-desk.zip
/export-desk.zip
/public/fastapi-rag.zip
/fastapi-rag.zip
/fastapi-rag/
/public/desk-rag.zip
/desk-rag.zip
/desk-rag/
/export-desk-fonte.txt

# Chroma persistent index
/chroma_data/
/__pycache__/
